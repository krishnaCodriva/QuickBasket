{
  "expo": {
    "name": "QuickBasket",
    "slug": "QuickBasket",
    "scheme": "quickbasket",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/adaptive-icon-centered.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/adaptive-icon-centered.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.krishnacodriva.QuickBasket"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-centered.png",
        "backgroundColor": "#0F172A"
      },
      "edgeToEdgeEnabled": false,
      "package": "com.krishnacodriva.QuickBasket",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "@react-native-google-signin/google-signin",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow QuickBasket to use your location."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you share them."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "fef6ec0f-7cbd-4b71-a70c-c9034ba0d9ea"
      }
    }
  }
}
